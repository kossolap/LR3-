title UML class diagram — Go implementation
skinparam classAttributeIconSize 0
hide empty members
top to bottom direction

package "lr3/structures" {

    class Array {
        - data: []string
        + NewArray(): *Array
        + PushBack(value: string)
        + Insert(index: int, value: string): bool
        + RemoveAt(index: int): bool
        + Set(index: int, value: string): bool
        + GetAt(index: int): (string, bool)
        + Get(): []string
        + Size(): int
        + Empty(): bool
        + Clear()
    }

    class LinkedList {
        - head: *fNode
        - tail: *fNode
        + NewLinkedList(): *LinkedList
        + Empty(): bool
        + Size(): int
        + Clear()
        + PushFront(value: string)
        + PushBack(value: string)
        + PopFront(): (string, bool)
        + PopBack(): (string, bool)
        + Index(index: int): (string, bool)
        + InsertBeforeValue(target: string, value: string): bool
        + InsertAfterValue(target: string, value: string): bool
        + RemoveValue(value: string): bool
        + RemoveBeforeValue(value: string): bool
        + RemoveAfterValue(value: string): bool
        + Find(value: string): int
        + Get(): []string
        + GetAfterValue(value: string): []string
        + GetBeforeValue(value: string): []string
    }

    class fNode <<private>> {
        - data: string
        - next: *fNode
    }

    class DoubleLinkedList {
        - head: *dNode
        - tail: *dNode
        + NewDoubleLinkedList(): *DoubleLinkedList
        + Empty(): bool
        + Size(): int
        + Clear()
        + PushFront(value: string)
        + PushBack(value: string)
        + PopFront(): (string, bool)
        + PopBack(): (string, bool)
        + Index(index: int): (string, bool)
        + InsertBeforeValue(target: string, value: string): bool
        + InsertAfterValue(target: string, value: string): bool
        + RemoveValue(value: string): bool
        + RemoveBeforeValue(value: string): bool
        + RemoveAfterValue(value: string): bool
        - removeNode(node: *dNode): (string, bool)
        + Find(value: string): int
        + Get(): []string
        + GetReverse(): []string
        + GetAfterValue(value: string): []string
        + GetBeforeValue(value: string): []string
    }

    class dNode <<private>> {
        - data: string
        - next: *dNode
        - prev: *dNode
    }

    class Queue {
        - head: *qNode
        - tail: *qNode
        + NewQueue(): *Queue
        + Empty(): bool
        + Size(): int
        + Push(value: string)
        + Pop(): (string, bool)
        + Get(): []string
        + Clear()
    }

    class qNode <<private>> {
        - data: string
        - next: *qNode
    }

    class Stack {
        - head: *sNode
        + NewStack(): *Stack
        + Empty(): bool
        + Size(): int
        + Push(value: string)
        + Pop(): (string, bool)
        + Get(): []string
        + Clear()
    }

    class sNode <<private>> {
        - data: string
        - next: *sNode
    }

    class HashTable {
        - table: []hashEntry
        - size: int
        + NewHashTable(capacity: int): *HashTable
        + Insert(key: int, value: string): error
        + Get(key: int): (string, bool)
        + Contains(key: int): bool
        + Remove(key: int): bool
        + Size(): int
        + Capacity(): int
        + Empty(): bool
        + Clear()
        + Entries(): map[int]string
        + String(): string
        - primaryHash(key: int): int
        - secondaryHash(key: int): int
        - findIndex(key: int): int
    }

    class hashEntry <<private>> {
        - key: int
        - value: string
        - state: uint8
    }

    class AVLTree {
        - root: *avlNode
        - size: int
        + NewAVLTree(): *AVLTree
        + Insert(key: int)
        + Remove(key: int): bool
        + Find(key: int): bool
        + Size(): int
        + Empty(): bool
        + Clear()
        + Inorder(): []int
        + Preorder(): []int
        + Postorder(): []int
        + Validate(): bool
    }

    class avlNode <<private>> {
        - key: int
        - left: *avlNode
        - right: *avlNode
        - height: int
    }

    LinkedList "1" *-- "0..*" fNode
    DoubleLinkedList "1" *-- "0..*" dNode
    Queue "1" *-- "0..*" qNode
    Stack "1" *-- "0..*" sNode
    HashTable "1" *-- "0..*" hashEntry
    AVLTree "1" *-- "0..*" avlNode
}

package "lr3/serialization" {

    class Data {
        + Array: *structures.Array
        + List: *structures.LinkedList
        + DList: *structures.DoubleLinkedList
        + Queue: *structures.Queue
        + Stack: *structures.Stack
        + HashTable: *structures.HashTable
        + AVLTree: *structures.AVLTree
    }

    class document <<internal>> {
        + Version: int
        + Array: []string
        + List: []string
        + DoubleList: []string
        + Queue: []string
        + Stack: []string
        + HashCapacity: int
        + HashEntries: []hashEntry
        + AVLKeys: []int
    }

    class hashEntry <<internal>> {
        + Key: int
        + Value: string
    }

    class SerializationFunctions <<package functions>> {
        + Serialize(data: *Data): ([]byte, error)
        + Deserialize(encoded: []byte): (*Data, error)
    }

    Data ..> Array
    Data ..> LinkedList
    Data ..> DoubleLinkedList
    Data ..> Queue
    Data ..> Stack
    Data ..> HashTable
    Data ..> AVLTree

    document *-- hashEntry
    SerializationFunctions ..> Data
    SerializationFunctions ..> document
}

note bottom of HashTable
  Hash table uses private entries,
  folding hash and double hashing.
end note

note bottom of AVLTree
  AVL tree stores integer keys.
  Node fields and root are private.
  Validate() checks AVL invariants.
end note

note bottom of SerializationFunctions
  JSON serialization.
  Format version: 1.
end note

@enduml
